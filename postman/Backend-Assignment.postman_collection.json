{
  "info": {
    "_postman_id": "6df99d2d-b7db-42dc-8144-9f9230799f85",
    "name": "Backend Assignment - Session Booking API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "userId", "value": "" },
    { "key": "teacherId", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "dateTimestamp", "value": "1793534400000" }
  ],
  "item": [
    { "name": "Create teacher", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Created', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "pm.collectionVariables.set('teacherId', body.data._id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Ada Teacher\",\n  \"email\": \"ada@example.com\",\n  \"specialization\": \"Mathematics\",\n  \"experience\": 5\n}" }, "url": "{{baseUrl}}/teachers" } },
    { "name": "Create user", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Created', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "pm.collectionVariables.set('userId', body.data._id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Akash Gaur\",\n  \"email\": \"akash@example.com\",\n  \"phone\": \"9876543210\"\n}" }, "url": "{{baseUrl}}/users" } },
    { "name": "Create session", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Created', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "pm.collectionVariables.set('sessionId', body.data._id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"startTime\": \"2026-11-01T10:00:00.000Z\",\n  \"endTime\": \"2026-11-01T11:00:00.000Z\"\n}" }, "url": "{{baseUrl}}/sessions" } },
    { "name": "Get available sessions", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Success', () => pm.response.to.have.status(200));", "pm.test('Array response', () => pm.expect(pm.response.json().data).to.be.an('array'));"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/sessions/available?dateTimestamp={{dateTimestamp}}" } },
    { "name": "Book session", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Booked', () => pm.response.to.have.status(200));"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\"\n}" }, "url": "{{baseUrl}}/sessions/{{sessionId}}/book" } },
    { "name": "Complete session", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Completed', () => pm.response.to.have.status(200));", "pm.test('Completed state', () => pm.expect(pm.response.json().data.status).to.eql('COMPLETED'));"] } }], "request": { "method": "PATCH", "url": "{{baseUrl}}/sessions/{{sessionId}}/complete" } },
    { "name": "Get user sessions", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Success', () => pm.response.to.have.status(200));", "const data = pm.response.json().data;", "pm.test('History groups exist', () => { pm.expect(data.upcomingSessions).to.be.an('array'); pm.expect(data.completedSessions).to.be.an('array'); });"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/users/{{userId}}/sessions" } }
  ]
}
